# 环境变量模板 —— 复制为 .env 后填入真实值（.env 已被 gitignore，严禁提交）
# 真实值只存在于本地 .env 或部署环境的 Secret 中。

# ===== LLM（智谱 OpenAI 兼容端点）=====
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://open.bigmodel.cn/api/paas/v4
MODEL=glm-4.5-air

# ===== HIGO 敏感请求头（由 core.config.loader 注入，绝不写入代码/yaml）=====
HIGO_ZYP=
HIGO_X_XC_AGENT=

# ===== A 项目数据库（仅测试环境；生产凭证禁止写入）=====
A_DB_HOST=
A_DB_PORT=3306
A_DB_USER=
A_DB_PASSWORD=

# ===== A 项目 Redis / MongoDB（仅测试环境）=====
A_REDIS_HOST=
A_REDIS_PORT=6379
A_REDIS_PASSWORD=
A_MONGO_HOSTS=
A_MONGO_USER=
A_MONGO_PASSWORD=
