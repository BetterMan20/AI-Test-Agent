{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "test_design.schema.json",
  "title": "AI Test Agent Test Design",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "test_points",
    "blocked_points",
    "coverage"
  ],
  "properties": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_test_points",
        "blocked_points"
      ],
      "properties": {
        "total_test_points": {
          "type": "integer",
          "minimum": 0
        },
        "blocked_points": {
          "type": "integer",
          "minimum": 0
        }
      }
    },

    "test_points": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/testPoint"
      }
    },

    "blocked_points": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/blockedPoint"
      }
    },

    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_ids",
        "rule_ids",
        "state_ids",
        "gap_ids"
      ],
      "properties": {
        "fact_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "rule_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "state_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "gap_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    }
  },

  "$defs": {

    "testPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "objective",
        "priority",
        "test_method",
        "source_facts",
        "source_rules",
        "source_states",
        "related_gaps",
        "design_basis"
      ],
      "properties": {

        "id": {
          "type": "string",
          "pattern": "^TP-[A-Z0-9-]+$"
        },

        "title": {
          "type": "string",
          "minLength": 1
        },

        "objective": {
          "type": "string",
          "minLength": 1
        },

        "priority": {
          "type": "string",
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ]
        },

        "test_method": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "equivalence_partitioning",
              "boundary_value_analysis",
              "decision_table",
              "cause_effect_graph",
              "state_transition",
              "error_guessing",
              "pairwise",
              "scenario_testing",
              "workflow_testing",
              "data_consistency",
              "time_boundary",
              "permission_testing",
              "compatibility_testing"
            ]
          },
          "uniqueItems": true
        },

        "source_facts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },

        "source_rules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },

        "source_states": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },

        "related_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },

        "design_basis": {
          "type": "string",
          "minLength": 1
        },

        "test_dimensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },

        "coverage_targets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },

    "blockedPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "priority",
        "related_gaps",
        "reason"
      ],
      "properties": {

        "id": {
          "type": "string",
          "pattern": "^TP-[A-Z0-9-]+$"
        },

        "title": {
          "type": "string",
          "minLength": 1
        },

        "priority": {
          "type": "string",
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ]
        },

        "related_gaps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },

        "reason": {
          "type": "string",
          "minLength": 1
        },

        "source_facts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    }
  }
}