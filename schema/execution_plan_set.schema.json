{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "execution_plan_set.schema.json",
  "title": "Execution Plan Set",
  "description": "汇聚产物：由 planner 从意图层（test_design.json / test_cases.json）批量生成的全部可执行计划。执行层（runner/engine）以本文件为输入契约，实现 意图 → 计划 → 执行 的可追溯闭环。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "plans"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generated_at",
        "source",
        "count",
        "mode"
      ],
      "properties": {
        "generated_at": { "type": "string", "description": "ISO8601 生成时间" },
        "source": { "type": "string", "description": "意图层来源文件（如 output/test_cases.json）" },
        "count": { "type": "integer", "minimum": 0 },
        "mode": { "type": "string", "description": "plan_from_test_case(LLM) | plan_from_dict(确定性) | mixed" },
        "generator": { "type": "string" },
        "failed": {
          "type": "array",
          "items": { "type": "string" },
          "description": "转计划失败的 TC（tc_id: 原因），不阻断批量"
        }
      }
    },
    "plans": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "execution_plan.schema.json" }
    }
  }
}
