{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quality_validation.schema.json",
  "title": "Quality Validation Result",
  "type": "object",
  "required": [
    "schema_version",
    "quality_status",
    "closed_loop",
    "completeness",
    "traceability",
    "requirement_completeness",
    "validator_evidence",
    "findings",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "quality_status": {
      "type": "string",
      "enum": [
        "PASS",
        "CONDITIONAL",
        "BLOCK"
      ]
    },
    "closed_loop": {
      "type": "boolean"
    },
    "completeness": {
      "type": "object",
      "required": [
        "facts",
        "analysis",
        "gaps",
        "test_design",
        "test_cases",
        "validation"
      ],
      "properties": {
        "facts": {
          "type": "boolean"
        },
        "analysis": {
          "type": "boolean"
        },
        "gaps": {
          "type": "boolean"
        },
        "test_design": {
          "type": "boolean"
        },
        "test_cases": {
          "type": "boolean"
        },
        "validation": {
          "type": "boolean"
        }
      }
    },
    "traceability": {
      "type": "object"
    },
    "requirement_completeness": {
      "type": "object"
    },
    "validator_evidence": {
      "type": "object"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "p0_count",
        "p1_count",
        "total_findings"
      ],
      "properties": {
        "p0_count": {
          "type": "integer",
          "minimum": 0
        },
        "p1_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_findings": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "quality_scope": {
      "type": "object"
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": [
        "category",
        "code",
        "severity",
        "message"
      ],
      "properties": {
        "category": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "P0",
            "P1",
            "P2"
          ]
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "object"
        }
      }
    }
  }
}