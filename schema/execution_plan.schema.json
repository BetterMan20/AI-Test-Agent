{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "execution_plan.schema.json",
  "title": "Execution Plan",
  "description": "Executable plan converted from a document-level test case. Each step has a polymorphic config based on its type.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tc_id",
    "title",
    "steps"
  ],
  "properties": {
    "tc_id": {
      "type": "string",
      "pattern": "^TC-[A-Z0-9]+-[0-9]{3,}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "test_data": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "type",
        "description"
      ],
      "properties": {
        "step_id": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "api",
            "db",
            "adb",
            "manual"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "config": {
          "type": "object"
        },
        "assertions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assertion"
          }
        },
        "evidence_types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "screenshot",
              "logcat",
              "api_response",
              "db_snapshot",
              "text"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "api"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/api_config"
              }
            },
            "required": [
              "config"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "db"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/db_config"
              }
            },
            "required": [
              "config"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "adb"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/adb_config"
              }
            },
            "required": [
              "config"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "manual"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/manual_config"
              }
            },
            "required": [
              "config"
            ]
          }
        }
      ]
    },
    "api_config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "path"
      ],
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "body": {},
        "params": {
          "type": "object"
        }
      }
    },
    "db_config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query"
      ],
      "properties": {
        "phase": {
          "type": "string",
          "enum": [
            "setup",
            "verify",
            "teardown"
          ]
        },
        "query": {
          "type": "string",
          "minLength": 1
        },
        "params": {}
      }
    },
    "adb_config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "manual_config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instruction"
      ],
      "properties": {
        "instruction": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "status_code",
            "json_path",
            "text_contains",
            "regex",
            "count",
            "db_rows"
          ]
        },
        "expected": {},
        "path": {
          "type": "string"
        },
        "pattern": {
          "type": "string"
        },
        "operator": {
          "type": "string",
          "enum": [
            "==",
            ">=",
            "<=",
            ">",
            "<",
            "!="
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "status_code"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "expected"
            ],
            "properties": {
              "expected": {
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "json_path"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "path",
              "expected"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "text_contains"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "expected"
            ],
            "properties": {
              "expected": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "regex"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "pattern"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "count"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "expected"
            ],
            "properties": {
              "expected": {
                "type": "integer"
              }
            }
          }
        }
      ]
    }
  }
}
