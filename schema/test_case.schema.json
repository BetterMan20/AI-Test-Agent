{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI QA TestCase Schema",
  "type": "object",
  "required": [
    "project",
    "modules"
  ],
  "additionalProperties": true,
  "properties": {
    "project": {
      "type": "string"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "testcases"
        ],
        "additionalProperties": true,
        "properties": {
          "name": {
            "type": "string"
          },
          "testcases": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "title",
                "steps"
              ],
              "additionalProperties": true,
              "properties": {
                "title": {
                  "type": "string"
                },
                "steps": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "action",
                      "expected"
                    ],
                    "additionalProperties": true,
                    "properties": {
                      "action": {
                        "type": "string"
                      },
                      "expected": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
