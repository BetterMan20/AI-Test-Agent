{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "test_case.schema.json",
  "title": "Test Case",
  "description": "Executable test cases generated from validated test design.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "test_cases",
    "blocked_cases"
  ],
  "properties": {
    "test_cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/testCase"
      }
    },
    "blocked_cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/blockedCase"
      }
    }
  },
  "$defs": {
    "testCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "priority",
        "test_point_id",
        "source_facts",
        "preconditions",
        "steps",
        "expected_results"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^TC-[A-Z0-9]+-[0-9]{3,}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "string",
          "enum": [
            "P0",
            "P1",
            "P2"
          ]
        },
        "test_point_id": {
          "type": "string",
          "pattern": "^TP-[A-Z0-9-]+$"
        },
        "source_facts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^F[0-9]{3,}$"
          }
        },
        "related_gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^G[0-9]{3,}$"
          }
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "test_data": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "step",
              "action"
            ],
            "properties": {
              "step": {
                "type": "integer",
                "minimum": 1
              },
              "action": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "expected_results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },

    "blockedCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test_point_id",
        "reason"
      ],
      "properties": {
        "test_point_id": {
          "type": "string",
          "pattern": "^TP-[A-Z0-9-]+$"
        },
        "related_gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^G[0-9]{3,}$"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}