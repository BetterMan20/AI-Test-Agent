{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "requirement_analysis.schema.json",
  "title": "Requirement Analysis — Business Model",
  "description": "Structured business model derived from Requirement Facts: entities, states, conditions, actions, outcomes, and their causal relations. Every element carries a 'derived' flag: false = directly supported by requirement facts, true = inferred by test reasoning.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "actors",
    "entities",
    "states",
    "conditions",
    "actions",
    "outcomes",
    "relations"
  ],
  "properties": {
    "actors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/actor" }
    },
    "entities": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/entity" }
    },
    "states": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/state" }
    },
    "conditions": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/condition" }
    },
    "actions": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/action" }
    },
    "outcomes": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/outcome" }
    },
    "relations": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/relation" }
    }
  },
  "$defs": {
    "sourceFacts": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "pattern": "^F[0-9]{3,}$"
      }
    },

    "nullableString": {
      "type": ["string", "null"]
    },

    "derivedConstraints": {
      "description": "Conditional constraints: derived=false requires source_facts with minItems 1; derived=true requires derivation_basis.",
      "allOf": [
        {
          "if": {
            "properties": { "derived": { "const": false } },
            "required": ["derived"]
          },
          "then": {
            "properties": {
              "source_facts": { "minItems": 1 }
            }
          }
        },
        {
          "if": {
            "properties": { "derived": { "const": true } },
            "required": ["derived"]
          },
          "then": {
            "required": ["derivation_basis"]
          }
        }
      ]
    },

    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "source_facts", "derived"],
      "allOf": [{ "$ref": "#/$defs/derivedConstraints" }],
      "properties": {
        "id": { "type": "string", "pattern": "^A[0-9]{3,}$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "source_facts": { "$ref": "#/$defs/sourceFacts" },
        "derived": { "type": "boolean" },
        "derivation_basis": { "$ref": "#/$defs/nullableString" }
      }
    },

    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "source_facts", "derived"],
      "allOf": [{ "$ref": "#/$defs/derivedConstraints" }],
      "properties": {
        "id": { "type": "string", "pattern": "^E[0-9]{3,}$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "attributes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "source_facts": { "$ref": "#/$defs/sourceFacts" },
        "derived": { "type": "boolean" },
        "derivation_basis": { "$ref": "#/$defs/nullableString" }
      }
    },

    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "entity_id", "description", "source_facts", "derived"],
      "allOf": [{ "$ref": "#/$defs/derivedConstraints" }],
      "properties": {
        "id": { "type": "string", "pattern": "^S[0-9]{3,}$" },
        "name": { "type": "string", "minLength": 1 },
        "entity_id": { "type": ["string", "null"], "pattern": "^E[0-9]{3,}$" },
        "description": { "type": "string", "minLength": 1 },
        "source_facts": { "$ref": "#/$defs/sourceFacts" },
        "derived": { "type": "boolean" },
        "derivation_basis": { "$ref": "#/$defs/nullableString" }
      }
    },

    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "content", "source_facts", "derived"],
      "allOf": [{ "$ref": "#/$defs/derivedConstraints" }],
      "properties": {
        "id": { "type": "string", "pattern": "^CN[0-9]{3,}$" },
        "content": { "type": "string", "minLength": 1 },
        "related_entity": { "$ref": "#/$defs/nullableString" },
        "related_state": { "$ref": "#/$defs/nullableString" },
        "source_facts": { "$ref": "#/$defs/sourceFacts" },
        "derived": { "type": "boolean" },
        "derivation_basis": { "$ref": "#/$defs/nullableString" }
      }
    },

    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "content", "source_facts", "derived"],
      "allOf": [{ "$ref": "#/$defs/derivedConstraints" }],
      "properties": {
        "id": { "type": "string", "pattern": "^AC[0-9]{3,}$" },
        "content": { "type": "string", "minLength": 1 },
        "actor_id": { "$ref": "#/$defs/nullableString" },
        "target_entity": { "$ref": "#/$defs/nullableString" },
        "source_facts": { "$ref": "#/$defs/sourceFacts" },
        "derived": { "type": "boolean" },
        "derivation_basis": { "$ref": "#/$defs/nullableString" }
      }
    },

    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "content", "source_facts", "derived"],
      "allOf": [{ "$ref": "#/$defs/derivedConstraints" }],
      "properties": {
        "id": { "type": "string", "pattern": "^O[0-9]{3,}$" },
        "content": { "type": "string", "minLength": 1 },
        "entity_id": { "$ref": "#/$defs/nullableString" },
        "state_change": { "$ref": "#/$defs/nullableString" },
        "source_facts": { "$ref": "#/$defs/sourceFacts" },
        "derived": { "type": "boolean" },
        "derivation_basis": { "$ref": "#/$defs/nullableString" }
      }
    },

    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "description", "source_facts", "derived"],
      "allOf": [{ "$ref": "#/$defs/derivedConstraints" }],
      "properties": {
        "id": { "type": "string", "pattern": "^REL[0-9]{3,}$" },
        "type": {
          "type": "string",
          "enum": [
            "condition_behavior",
            "state_transition",
            "action_outcome",
            "entity_relation",
            "flow_precedes"
          ]
        },
        "condition_id": { "$ref": "#/$defs/nullableString" },
        "action_id": { "$ref": "#/$defs/nullableString" },
        "outcome_id": { "$ref": "#/$defs/nullableString" },
        "from_state_id": { "$ref": "#/$defs/nullableString" },
        "to_state_id": { "$ref": "#/$defs/nullableString" },
        "source_entity": { "$ref": "#/$defs/nullableString" },
        "target_entity": { "$ref": "#/$defs/nullableString" },
        "description": { "type": "string", "minLength": 1 },
        "source_facts": { "$ref": "#/$defs/sourceFacts" },
        "derived": { "type": "boolean" },
        "derivation_basis": { "$ref": "#/$defs/nullableString" }
      }
    }
  }
}
