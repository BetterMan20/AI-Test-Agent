# PyCharm
.idea/

# Python
.venv/
__pycache__/
*.pyc

# 环境变量
.env

# 输出目录
output/

# 敏感凭证 / 签名绑定样本（严禁入库）
testdata/**/*.auth.yaml
testdata/**/*.auth.*
secrets/

# 登录样本 / 账号库（含真实手机号与口令，严禁入库）
_cred_library.json
_login_samples.json
_seat_samples.json

# Appium 运行时依赖（60MB+，由 scripts/setup_appium_env.ps1 安装）
**/node_modules/

# 本地缓存 / 临时目录
.pytest_cache/
.tmp/
scratch/

# 密钥 / 证书 / 私钥（严禁入库）
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.ppk
id_rsa*
id_ed25519*
.env.*
!.env.example

# 运行日志（可能夹带请求头 / token）
*.log