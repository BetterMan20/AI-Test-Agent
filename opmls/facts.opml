text="F130"><outline text="弹幕文案格式：xxx1（发送者昵称） send a lucky bag xxx2 coins（金币），view detail&gt;" /><outline text="来源：展示（已有逻辑）" /><outline text="类型：ATTRIBUTE" /></outline><outline text="F131"><outline text="点击view detail&gt;可跳转至发送者当前红包的状态（倒计时、可抢状态、抢完后详情）" /><outline text="来源：交互" /><outline text="类型：ACTION" /></outline><outline text="F132"><outline text="红包挂件" /><outline text="来源：老版本兼容" /><outline text="类型：OBJECT" /></outline><outline text="F133"><outline text="红包挂件变更" /><outline text="来源：老版本兼容" /><outline text="类型：OBJECT" /></outline><outline text="F134"><outline text="红包挂件位置非常驻" /><outline text="来源：老版本兼容-位置" /><outline text="类型：ATTRIBUTE" /></outline><outline text="F135"><outline text="红包挂件位于语音房右下角挂件区" /><outline text="来源：老版本兼容-位置" /><outline text="类型：ATTRIBUTE" /></outline><outline text="F136"><outline text="挂件优先级包含mini跨房PK条" /><outline text="来源：老版本兼容-挂件优先级" /><outline text="类型：CONFIGURATION" /></outline><outline text="F137"><outline text="mini跨房PK条在跨房PK开启时且是休闲游戏模式下才显示" /><outline text="来源：老版本兼容-挂件优先级" /><outline text="类型：CONDITION" /></outline><outline text="F138"><outline text="挂件优先级包含红包入口" /><outline text="来源：老版本兼容-挂件优先级" /><outline text="类型：CONFIGURATION" /></outline><outline text="F139"><outline text="挂件优先级包含房间等级火箭入口" /><outline text="来源：老版本兼容-挂件优先级" /><outline text="类型：CONFIGURATION" /></outline><outline text="F140"><outline text="挂件优先级包含游戏入口挂件Banner" /><outline text="来源：老版本兼容-挂件优先级" /><outline text="类型：CONFIGURATION" /></outline><outline text="F141"><outline text="挂件优先级包含运营挂件Banner" /><outline text="来源：老版本兼容-挂件优先级" /><outline text="类型：CONFIGURATION" /></outline><outline text="F142"><outline text="红包挂件适配超过部分做上下滑动处理" /><outline text="来源：老版本兼容-适配" /><outline text="类型：CONFIGURATION" /></outline><outline text="F143"><outline text="红包挂件适配钓鱼房场景" /><outline text="来源：老版本兼容-适配" /><outline text="类型：CONFIGURATION" /></outline><outline text="F144"><outline text="红包挂件适配游戏模式场景" /><outline text="来源：老版本兼容-适配" /><outline text="类型：CONFIGURATION" /></outline><outline text="F145"><outline text="红包挂件适配小屏手机场景" /><outline text="来源：老版本兼容-适配" /><outline text="类型：CONFIGURATION" /></outline><outline text="F146"><outline text="红包挂件样式为红包图案+红包数量" /><outline text="来源：老版本兼容-样式" /><outline text="类型：ATTRIBUTE" /></outline><outline text="F147"><outline text="红包挂件展示上限100个" /><outline text="来源：老版本兼容-数量上限" /><outline text="类型：LIMIT" /></outline><outline text="F148"><outline text="红包挂件&gt;100不展示" /><outline text="来源：老版本兼容-数量上限" /><outline text="类型：LIMIT" /></outline><outline text="F149"><outline text="红包挂件以发送红包的前-后排序" /><outline text="来源：老版本兼容-数量上限" /><outline text="类型：RULE" /></outline><outline text="F150"><outline text="用户已抢红包（抢到多少、没抢到），红包数量减1" /><outline text="来源：老版本兼容-数量展示" /><outline text="类型：RULE" /></outline><outline text="F151"><outline text="红包已抢完后数量减1" /><outline text="来源：老版本兼容-数量展示" /><outline text="类型：RULE" /></outline><outline text="F152"><outline text="红包挂件有2种动效" /><outline text="来源：老版本兼容-动效" /><outline text="类型：CONFIGURATION" /></outline><outline text="F153"><outline text="正在红包倒计时状态" /><outline text="来源：老版本兼容-动效" /><outline text="类型：STATE" /></outline><outline text="F154"><outline text="抖动红包展示" /><outline text="来源：老版本兼容-动效" /><outline text="类型：ACTION" /></outline><outline text="F155"><outline text="红包倒计时结束状态" /><outline text="来源：老版本兼容-动效" /><outline text="类型：STATE" /></outline><outline text="F156"><outline text="用户关闭红包领取弹窗页" /><outline text="来源：老版本兼容-动效" /><outline text="类型：ACTION" /></outline><outline text="F157"><outline text="红包未抢完时" /><outline text="来源：老版本兼容-动效" /><outline text="类型：CONDITION" /></outline><outline text="F158"><outline text="红包挂件从抖动展示变为红包张开撒金币的动效展示" /><outline text="来源：老版本兼容-动效" /><outline text="类型：TRANSITION" /></outline><outline text="F159"><outline text="无论用户抢没抢红包，若倒计时结束，红包已抢完（发送个数=领取个数），则该红包挂件消失" /><outline text="来源：老版本兼容-展示时效" /><outline text="类型：RULE" /></outline><outline text="F160"><outline text="若用户已抢红包（抢到多少、没抢到），则该红包挂件消失" /><outline text="来源：老版本兼容-展示时效" /><outline text="类型：RULE" /></outline><outline text="F161"><outl