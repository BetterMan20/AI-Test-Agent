<?xml version='1.0' encoding='utf-8'?>
<opml version="2.0"><head><title>需求事实</title></head><body><outline text="需求事实"><outline text="F001"><outline text="运营侧" /><outline text="来源：便于运营侧对异常用户及时处理...新增svip指定下发能力" /><outline text="类型：ACTOR" /></outline><outline text="F002"><outline text="svip体验卡" /><outline text="来源：在后台新增svip指定下发能力" /><outline text="类型：OBJECT" /></outline><outline text="F003"><outline text="op后台支持展示用户svip等级" /><outline text="来源：op后台支持展示用户svip等级。" /><outline text="类型：ACTION" /></outline><outline text="F004"><outline text="对单个用户进行「增加svip身份」操作" /><outline text="来源：对单个用户进行「增加svip身份」操作" /><outline text="类型：ACTION" /></outline><outline text="F005"><outline text="增加svip身份可获得对应特权奖励" /><outline text="来源：给用户添加「svip等级」并获得对应特权奖励" /><outline text="类型：ACTION" /></outline><outline text="F006"><outline text="增加svip身份可选择下发有效期" /><outline text="来源：有效期支持选择；下月svip等级逻辑正常按上个月累积的成长值进行升降级判断; ii. 选择svip身份等级 ... iii. 点击提交，立即生效" /><outline text="类型：ACTION" /></outline><outline text="F007"><outline text="体验卡下发后不自动生效，需用户手动点击后开启" /><outline text="来源：所有卡片下发后不自动生效，需用户手动点击后开启，使用二次确认弹窗" /><outline text="类型：ACTION" /></outline><outline text="F008"><outline text="体验卡名称格式为xxx1h-SVIPxxx2体验（xxx1=生效时长）" /><outline text="来源：名称：xxx1h-SVIPxxx2体验（xxx1=生效时长）" /><outline text="类型：ATTRIBUTE" /></outline><outline text="F009"><outline text="卡片有效期选择为天数" /><outline text="来源：卡片有效期：选择天数，下发立即开始倒计时。" /><outline text="类型：CONDITION" /></outline><outline text="F010"><outline text="体验时长填写为小时" /><outline text="来源：体验时长：填写小时，点击开启使用后，开始倒计时。" /><outline text="类型：CONDITION" /></outline><outline text="F011"><outline text="两个时长（有效期时间和体验时长）任一到期后，卡片消失" /><outline text="来源：两个时长任一到期后，卡片消失。" /><outline text="类型：RULE" /></outline><outline text="F012"><outline text="是否支持转赠为单选，默认不可转赠" /><outline text="来源：是否支持转赠（单选）：默认不可转赠。" /><outline text="类型：ATTRIBUTE" /></outline><outline text="F013"><outline text="下发可转赠时，未开启使用的卡片可转赠；不可转赠时不展示转赠按钮" /><outline text="来源：若下发可转赠，则未开启使用的卡片可转赠；若不可转赠则不展示转赠按钮" /><outline text="类型：RULE" /></outline><outline text="F014"><outline text="活动奖池等其他获取场景默认不可转赠" /><outline text="来源：活动奖池等其他获取场景默认不可转赠" /><outline text="类型：RULE" /></outline><outline text="F015"><outline text="钓鱼奖池奖品可转赠" /><outline text="来源：钓鱼奖池奖品可转赠" /><outline text="类型：RULE" /></outline><outline text="F016"><outline text="体验卡存放于背包道具面板、钓鱼背包" /><outline text="来源：存放：背包道具面板、钓鱼背包" /><outline text="类型：ACTION" /></outline><outline text="F017"><outline text="体验卡使用前需用户手动点击开启，并显示二次确认弹窗" /><outline text="来源：所有卡片下发后不自动生效，需用户手动点击后开启，使用二次确认弹窗" /><outline text="类型：ACTION" /></outline><outline text="F018"><outline text="二次确认弹窗文案包含确认开启体验的提示信息" /><outline text="来源：确认开启使用SVIPxxx1体验，剩余体验时长：xxx2小时，卡片有效期：xxx3天。" /><outline text="类型：ATTRIBUTE" /></outline><outline text="F019"><outline text="用户可手动切换体验卡，切换时显示二次确认弹窗" /><outline text="来源：用户可手动点击切换体验卡，切换体验等级。若切换则二次确认弹窗..." /><outline text="类型：ACTION" /></outline><outline text="F020"><outline text="切换体验卡后暂停原卡片剩余生效时长，并开启新卡片" /><outline text="来源：切换后关闭老的体验卡，暂停保留剩余生效时长。可重新开启使用。同时为用户自动开启新的体验卡和对应等级。" /><outline text="类型：ACTION" /></outline><outline text="F021"><outline text="下发卡片时触发一条im消息" /><outline text="来源：下发卡片时同时触发一条im" /><outline text="类型：ACTION" /></outline><outline text="F022"><outline text="卡片临期（距过期不足48h）时触发im消息" /><outline text="来源：svipxxx1体验卡距离过期不足48h时" /><outline text="类型：ACTION" /></outline><outline text="F023"><outline text="卡片过期时触发一条im消息" /><outline text="来源：过期时触发一条im" /><outline text="类型：ACTION" /></outline></outline></body></opml>