<?xml version='1.0' encoding='utf-8'?>
<opml version="2.0"><head><title>需求分析</title></head><body><outline text="svip体验卡相关需求分析"><outline text="A 下发渠道"><outline text="业务上下文"><outline text="svip体验卡" /><outline text="下发来源" /></outline><outline text="来源规则"><outline text="作为体验卡下发来源，包含任务数据源、榜单数据源、抽奖池" /><outline text="作为体验卡下发来源，用于ka-offer类型下发" /><outline text="作为体验卡下发来源" /><outline text="作为体验卡下发来源，其奖品可转赠" /><outline text="作为体验卡下发来源" /><outline text="作为体验卡下发来源" /><outline text="作为体验卡下发来源" /><outline text="作为体验卡下发来源" /></outline></outline><outline text="B OP后台展示"><outline text="业务上下文"><outline text="svip等级" /><outline text="用户展示" /></outline><outline text="业务规则"><outline text="op后台展示用户SVIP等级规则" /></outline><outline text="状态规则"><outline text="{'object': 'svip等级', 'states': ['生效中', '已过期', '已失效'], 'transitions': [{'from': '生效中', 'to': '已过期', 'trigger': '卡片有效期到期'}, {'from': '生效中', 'to': '已失效', 'trigger': '体验时长到期'}, {'from': '已过期', 'to': '已失效', 'trigger': '体验时长到期'}]}" /></outline><outline text="数据规则"><outline text="体验卡生效后等级同步" /><outline text="到期后等级恢复" /></outline><outline text="时间规则"><outline text="到期触发等级恢复" /></outline></outline><outline text="C OP手动增加SVIP"><outline text="业务上下文"><outline text="svip身份" /><outline text="增加操作" /></outline><outline text="业务规则"><outline text="增加svip身份操作规则" /><outline text="选择等级" /><outline text="选择有效期" /><outline text="立即生效" /><outline text="下月升降级" /></outline><outline text="状态规则"><outline text="{'object': 'svip身份', 'states': ['未生效', '生效中', '已过期'], 'transitions': [{'from': '未生效', 'to': '生效中', 'trigger': '用户确认开启'}, {'from': '生效中', 'to': '已过期', 'trigger': '卡片有效期到期'}, {'from': '已过期', 'to': '已失效', 'trigger': '体验时长到期'}]}" /></outline><outline text="数据规则"><outline text="选择等级" /><outline text="选择有效期" /><outline text="下月升降级" /></outline><outline text="时间规则"><outline text="有效期倒计时" /><outline text="体验时长倒计时" /></outline><outline text="约束"><outline text="选择等级" /><outline text="选择有效期" /><outline text="立即生效" /></outline></outline><outline text="D 体验卡有效期"><outline text="业务上下文"><outline text="有效期" /><outline text="倒计时" /><outline text="到期" /></outline><outline text="业务规则"><outline text="有效期选择天数，下发立即开始倒计时" /><outline text="存量卡片无有效期设兜底时长" /></outline><outline text="状态规则"><outline text="{'object': '体验卡有效期', 'states': ['有效中', '已过期'], 'transitions': [{'from': '有效中', 'to': '已过期', 'trigger': '倒计时结束'}, {'from': '已过期', 'to': '已失效', 'trigger': '体验时长到期'}]}" /></outline><outline text="数据规则"><outline text="有效期倒计时" /><outline text="兜底时长设置" /></outline><outline text="时间规则"><outline text="有效期倒计时" /><outline text="到期触发兜底逻辑" /></outline><outline text="约束"><outline text="有效期倒计时" /><outline text="兜底时长" /></outline></outline><outline text="E 体验时长"><outline text="业务上下文"><outline text="体验" /><outline text="倒计时" /><outline text="到期" /></outline><outline text="业务规则"><outline text="填写小时，点击开启使用后开始倒计时" /><outline text="两个时长任一到期后卡片消失" /></outline><outline text="状态规则"><outline text="{'object': '体验时长', 'states': ['有效中', '已过期'], 'transitions': [{'from': '有效中', 'to': '已过期', 'trigger': '倒计时结束'}, {'from': '已过期', 'to': '已失效', 'trigger': '卡片有效期到期'}]}" /></outline><outline text="数据规则"><outline text="体验时长消耗计时" /><outline text="双时长关系" /></outline><outline text="时间规则"><outline text="体验时长倒计时" /><outline text="双时长到期逻辑" /></outline><outline text="约束"><outline text="双时长任一到期后卡片消失" /></outline></outline><outline text="F 转赠"><outline text="业务上下文"><outline text="转赠" /><outline text="条件" /><outline text="按钮显示" /></outline><outline text="业务规则"><outline text="默认不可转赠" /><outline text="可转赠条件" /><outline text="不可转赠不展示按钮" /><outline text="钓鱼奖池可转赠" /><outline text="已开启不可转赠" /></outline><outline text="状态规则"><outline text="{'object': '转赠状态', 'states': ['可转赠', '不可转赠'], 'transitions': [{'from': '不可转赠', 'to': '可转赠', 'trigger': '满足可转赠条件'}, {'from': '可转赠', 'to': '不可转赠', 'trigger': '已开启使用'}]}" /></outline><outline text="数据规则"><outline text="转赠条件判断" /><outline text="按钮显示控制" /></outline><outline text="约束"><outline text="默认不可转赠" /><outline text="钓鱼奖池可转赠" /><outline text="已开启不可转赠" /></outline></outline><outline text="G 卡片展示"><outline text="业务上下文"><outline text="卡片" /><outline text="展示方式" /><outline text="倒计时" /></outline><outline text="业务规则"><outline text="独立展示不合并" /><outline text="独立倒计时" /><outline text="名称格式" /><outline text="存量卡片兜底时长" /></outline><outline text="状态规则"><outline text="{'object': '体验卡', 'states': ['未展示', '展示中', '已过期'], 'transitions': [{'from': '未展示', 'to': '展示中', 'trigger': '用户确认开启'}, {'from': '展示中', 'to': '已过期', 'trigger': '卡片过期或时长过期'}]}" /></outline><outline text="数据规则"><outline text="独立展示" /><outline text="倒计时独立" /><outline text="名称格式" /></outline><outline text="时间规则"><outline text="倒计时独立" /><outline text="兜底时长设置" /></outline><outline text="约束"><outline text="独立展示不合并" /><outline text="独立倒计时" /><outline text="名称格式" /><outline text="兜底时长" /></outline></outline><outline text="H 体验卡开启"><outline text="业务上下文"><outline text="体验卡" /><outline text="开启" /><outline text="二次确认" /></outline><outline text="业务规则"><outline text="不自动生效" /><outline text="手动开启" /><outline text="二次确认弹窗" /><outline text="弹窗文案" /></outline><outline text="状态规则"><outline text="{'object': '体验卡', 'states': ['未开启', '使用中', '暂停', '已过期', '已失效'], 'transitions': [{'from': '未开启', 'to': '使用中', 'trigger': '用户确认开启'}, {'from': '使用中', 'to': '暂停', 'trigger': '用户确认切换'}, {'from': '暂停', 'to': '使用中', 'trigger': '用户重新开启'}]}" /></outline><outline text="数据规则"><outline text="二次确认流程" /><outline text="弹窗文案" /></outline><outline text="时间规则"><outline text="倒计时从开启时开始" /><outline text="到期触发逻辑" /></outline><outline text="约束"><outline text="不自动生效" /><outline text="二次确认弹窗" /><outline text="弹窗文案" /></outline></outline><outline text="I 体验卡切换"><outline text="业务上下文"><outline text="体验卡" /><outline text="切换" /><outline text="暂停" /></outline><outline text="业务规则"><outline text="可手动切换" /><outline text="切换则二次确认" /><outline text="暂停原卡" /><outline text="自动开启新卡" /><outline text="重新开启" /></outline><outline text="状态规则"><outline text="{'object': '体验卡', 'states': ['未开启', '使用中', '暂停', '已过期', '已失效'], 'transitions': [{'from': '使用中', 'to': '暂停', 'trigger': '用户确认切换'}, {'from': '暂停', 'to': '使用中', 'trigger': '用户重新开启'}]}" /></outline><outline text="数据规则"><outline text="切换确认流程" /><outline text="暂停与开启逻辑" /></outline><outline text="时间规则"><outline text="暂停后保留剩余时长" /><outline text="新卡倒计时开始" /></outline><outline text="约束"><outline text="切换则二次确认" /><outline text="暂停原卡" /><outline text="自动开启新卡" /><outline text="重新开启" /></outline></outline><outline text="J IM触达"><outline text="业务上下文"><outline text="IM" /><outline text="临期" /><outline text="过期" /><outline text="不重复" /></outline><outline text="业务规则"><outline text="获取：下发时触发im" /><outline text="临期：不足48h触发" /><outline text="过期：触发时触发" /><outline text="不重复发送" /></outline><outline text="状态规则"><outline text="{'object': 'IM消息', 'states': ['未触发', '待触发', '已触发'], 'transitions': [{'from': '未触发', 'to': '待触发', 'trigger': '距离过期不足48h'}, {'from': '待触发', 'to': '已触发', 'trigger': '过期时间到达'}, {'from': '已触发', 'to': '已触发', 'trigger': '重复检测'}]}" /></outline><outline text="数据规则"><outline text="IM文案规则" /><outline text="触发时机规则" /></outline><outline text="时间规则"><outline text="临期48h触发" /><outline text="过期时触发" /><outline text="不重复发送" /></outline><outline text="约束"><outline text="临期48h触发" /><outline text="过期时触发" /><outline text="不重复发送" /></outline></outline><outline text="K 白名单"><outline text="业务上下文"><outline text="白名单" /><outline text="权限" /><outline text="资格" /></outline><outline text="业务规则"><outline text="Consul配置白名单" /><outline text="白名单可见新等级" /><outline text="非白名单不可见" /><outline text="只进不出" /><outline text="到期后充值解锁" /></outline><outline text="状态规则"><outline text="{'object': '用户白名单状态', 'states': ['未加入', '已加入', '已失效'], 'transitions': [{'from': '未加入', 'to': '已加入', 'trigger': '添加到Consul配置'}, {'from': '已加入', 'to': '已失效', 'trigger': '删除Consul配置'}, {'from': '已失效', 'to': '已失效', 'trigger': '后续操作'}]}" /></outline><outline text="数据规则"><outline text="白名单权限控制" /><outline text="等级页面可见性" /></outline><outline text="时间规则"><outline text="只进不出" /><outline text="到期后充值解锁" /></outline><outline text="约束"><outline text="Consul配置白名单" /><outline text="只进不出" /><outline text="到期后充值解锁" /></outline></outline></outline></body></opml>